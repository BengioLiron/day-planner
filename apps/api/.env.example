# Copy to .env for local development, and set the same names as variables on Railway.
# Never commit .env.

PORT=8787

# The address people open. On Railway: your https://….up.railway.app address.
# Locally it defaults to http://localhost:8787.
# PUBLIC_URL=

# Sign-in password, at least 12 characters. Required in production.
# Leave empty locally to skip sign-in while developing.
APP_PASSWORD=

# 32 random bytes, base64. Encrypts AI keys and calendar credentials, and signs sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: if it changes, saved keys can't be decrypted and everyone is signed out.
ENCRYPTION_KEY=

# Google Calendar (Google Cloud Console → APIs & Services → Credentials → OAuth client, type "Web application").
# Enable the Google Calendar API, and add <PUBLIC_URL>/api/calendar/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <PUBLIC_URL>/api/calendar/google/callback
# GOOGLE_REDIRECT_URI=

# Where tasks and encrypted keys are stored. The Docker image uses /data/store.json (the volume).
DATA_FILE=./data/store.json

# Local development only: where the web dev server runs.
WEB_ORIGIN=http://localhost:5173
